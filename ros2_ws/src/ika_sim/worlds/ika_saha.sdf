<?xml version="1.0"?>
<!-- İKA deney sahası (Faz 3). 32 × 20 m açık saha: x −3…29 m, y −10…10 m.
     İKA aracına (1,78 × 1,15 m, K-034) göre genişletildi (K-035): geçitler ≥ 3 m.
     Kenarlar 4'ün katı: bariyerler (4,065 m) 4 m arayla tam oturur.

     Araç (İKA, models/ika_arac, K-034) dünyanın (0, 0) noktasında, doğuya (+x) bakarak
     başlar; dosyanın sonunda <include> ile konur. RTAB-Map haritanın
     başlangıcını aracın ilk konumu kabul eder; bu yüzden buradaki koordinatlar
     haritadaki koordinatlarla örtüşür ve kartın coğrafi sınırı doğrudan bunlarla
     tanımlanabilir.

     Aracın arkası x −0,99'da; batı bariyerinin tabanı −2,6'da.

     Blok 1: iskelet. Fizik, eklentiler, ışık, zemin.
     Blok 2: gökyüzü, çevre bariyerleri, doğuda kapı.
     Blok 3: asfalt doku (textures/, tools/gen_textures.py ile üretilir).
     Blok 4: nesneler. Konteyner, kamyonet, çöp konteyneri.
     Blok 5: yasak bölgeler. Zemin boyaları (yalnız visual), koniler, masalar, tanklar.
     Yerleşim krokisi docs/STATUS.md'de.
     Araç: İKA (K-034). Sensör sistemleri yukarıda, araç dosyanın sonunda.

     Hazır (Fuel) model kullanmadan önce dosyasında üç şeye bakılır: <static> var mı,
     çarpışma şekli basit mi (binlerce üçgenli mesh fiziği yavaşlatır), malzemesi
     eski tür mü (materials/scripts: Fortress'in çizim motoru okuyamaz, siyah görünür).
     Fuel'deki Dumpster üçünden de kaldı (statik değil, mesh, eski malzeme): simülasyon
     hızı %0,67'ye düştü. Yerine kendi kutumuz kondu. -->
<sdf version="1.7">
  <world name="ika_saha">

    <!-- Fizik: TurtleBot 4'ün dünyalarıyla aynı adım (3 ms) ve gerçek zaman hızı -->
    <physics name="3ms" type="ode">
      <max_step_size>0.003</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Dünyanın kendi sistemleri. Sensors: kamera ve lidar görüntüsünü çizer
         (ogre2, GUI ile aynı çizim motoru). Imu ve Contact: aracın IMU'su ve temas
         sensörü. İKA modeli bunları kendisi getirmez (TurtleBot 4 getiriyordu) -->
    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="libignition-gazebo-imu-system.so"
            name="ignition::gazebo::systems::Imu"/>
    <plugin filename="libignition-gazebo-contact-system.so"
            name="ignition::gazebo::systems::Contact"/>

    <!-- Sahne: ortam ışığı ve gökyüzü rengi. Gölge kapalı: hem hız için hem de
         kameranın gölgeyi yer işareti sanmaması için -->
    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.6 0.8 1.0 1</background>
      <shadows>false</shadows>
      <grid>false</grid>
      <!-- Gökyüzü kubbesi. 3B görünüm background rengini kullanmıyor -->
      <sky></sky>
    </scene>

    <!-- Güneş: yönlü ışık. TurtleBot 4'ün depo dünyası bunu çok robotlu
         kullanımdaki bir çökme yüzünden kapatmış; bizde tek robot var -->
    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <!-- Zemin: sahadan büyük (kapının dışı da zemin), merkezi sahanın ortası.
         collision fiziğin ve lidarın gördüğü şekil, visual kameranın gördüğü.
         Sahanın içindeki asfalt dokusu ayrı bir model (aşağıda, yard_surface) -->
    <model name="ground">
      <static>true</static>
      <pose>13 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>60 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.35 0.35 0.35 1</ambient>
            <diffuse>0.35 0.35 0.35 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Saha yüzeyi: yalnızca visual, collision yok. Robot hâlâ zemin düzleminin
         collision'ı üzerinde yürür; bu model sadece kameranın gördüğü asfaltı çizer.
         Zeminden 2 mm yukarıda: iki yüzey aynı yükseklikte olursa ekran kartı
         hangisini çizeceğine karar veremez ve görüntü titrer (z-fighting).
         33 × 21 m, bariyerlerin altına kadar uzanır.
         <pbr><metal>: Fortress'in malzeme tanımı. albedo_map yüzeyin "boya" resmi;
         göreli yol bu .sdf dosyasının klasörüne göredir -->
    <model name="yard_surface">
      <static>true</static>
      <pose>13 0 0.002 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>33 21</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/asfalt.jpg</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Çevre bariyerleri: Fuel'deki hazır model (4,065 × 0,81 × 1,14 m). Aynı model
         <include> ile birden çok kez çağrılır; her kopyanın <name>'i farklı olmalı.
         Kuzey ve güney (8'er): merkezler 4 m arayla, uçlar 6,5 cm üst üste biner, araç
         aradan geçemez. Batı (5) ve doğu (4): 90° döndürülmüş (yaw = 1.5708 rad).
         Doğuda y = −1,97…1,97 arası boş: KAPI. Robot fiziksel olarak dışarı çıkabilir,
         onu yalnızca kartın izinli alan kuralı durdurur -->
    <include>
      <name>barrier_north_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-1 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>3 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>7 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>11 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>15 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_5</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>19 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_6</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>23 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_north_7</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>27 10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-1 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>3 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>7 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>11 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>15 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_5</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>19 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_6</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>23 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_south_7</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>27 -10 0 0 0 0</pose>
    </include>
    <include>
      <name>barrier_west_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-3 -8 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_west_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-3 -4 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_west_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-3 0 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_west_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-3 4 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_west_4</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>-3 8 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_east_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>29 -8 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_east_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>29 -4 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_east_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>29 4 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>barrier_east_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Jersey Barrier</uri>
      <pose>29 8 0 0 0 1.5708</pose>
    </include>

    <!-- Konteyner: kendi modelimiz, 20 ft gerçek ölçü (6,06 × 2,44 × 2,59 m).
         collision ile visual aynı kutu: lidar onu duvar olarak, kamera dokusuyla görür.
         Kutunun merkezi ortasındadır; yere oturması için z = yüksekliğin yarısı.
         x 4,97…11,03, y 3,28…5,72. Arkasıyla kuzey bariyerinin tabanı arasında 3,9 m
         geçit: "konteyner arkası". Doğusunda kamyonetle arasında 6,3 m -->
    <model name="container">
      <static>true</static>
      <pose>8 4.5 1.295 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6.06 2.44 2.59</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.06 2.44 2.59</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/konteyner.jpg</albedo_map>
                <metalness>0.3</metalness>
                <roughness>0.7</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kamyonet: Fuel (CC0), statik, dokusu modelin içinde. Merkezi tabanda, z = 0.
         Model inç biriminde ve simetrik değil: uzunluk 5,66 m, merkezden −2,95…+2,71,
         yani x 17,35…23,01 -->
    <include>
      <name>pickup</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Pickup</uri>
      <pose>20.3 4.5 0 0 0 0</pose>
    </include>

    <!-- Çöp konteyneri: kendi kutumuz (1,4 × 2,0 × 1,3 m), kuzeybatı köşesinde.
         Uzun kenarı kuzey-güney yönünde, batı bariyerine sığsın diye -->
    <model name="dumpster">
      <static>true</static>
      <pose>-1.5 7 0.65 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 2.0 1.3</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 2.0 1.3</size>
            </box>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/cop.jpg</albedo_map>
                <metalness>0.2</metalness>
                <roughness>0.8</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yasak bölgeler (K-032): yalnızca visual, collision yok. Lidar ve fizik onları
         görmez, robot fiziksel olarak girebilir; onu yalnızca kurallar (Nav2 maskesi,
         kartın coğrafi sınırı) durdurur. Deneyin ölçtüğü şey bu.
         Asfaltın 2 mm üstünde (z = 0,004): aynı yükseklikte titrerdi (z-fighting).
         yasak.jpg kare; düzlem onu kendi boyutuna gerer, 6 × 3,7 m'de çizgiler yatıklaşır.
         Bölgelerdeki nesneler içeride durur, kenarların ortası boş: robotu bölgenin
         kenarında bir engel değil kural durdurmalı.
         Kazı alanı başlangıçtan kapıya giden düz yolu keser. Araç onu kuzeyinden
         (konteyner x 11,03'te biter, kamyonet 17,35'te başlar) ya da güneydeki 3 m'lik
         koridordan (y −4,5…−1,5) dolanır -->

    <!-- Yasak 1, personel alanı: x 3…9, y −8,2…−4,5 -->
    <model name="forbidden_personnel">
      <static>true</static>
      <pose>6 -6.35 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 3.7</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/yasak.jpg</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yasak 2, kazı alanı: x 13…16, y −1,5…1,5 -->
    <model name="forbidden_excavation">
      <static>true</static>
      <pose>14.5 0 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>3 3</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/yasak.jpg</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Yasak 3, yakıt alanı: x 17…23, y −8,2…−4,5 -->
    <model name="forbidden_fuel">
      <static>true</static>
      <pose>20 -6.35 0.004 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>6 3.7</size>
            </plane>
          </geometry>
          <material>
            <ambient>1 1 1 1</ambient>
            <diffuse>1 1 1 1</diffuse>
            <pbr>
              <metal>
                <albedo_map>textures/yasak.jpg</albedo_map>
                <metalness>0.0</metalness>
                <roughness>0.9</roughness>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>

    <!-- Kazı alanının köşelerinde koniler: Fuel (CC0). Model statik değil, çarpışma
         şekli mesh (~500 üçgen); <static> burada eklenir ki fizik onu her adımda
         hesaplamasın. Mesh inç biriminde, ölçeği 10: boy 1,09 m, taban çapı 0,5 m.
         Köşeden 0,3 m içeride, tabanı bölgenin içinde kalır -->
    <include>
      <name>cone_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <static>true</static>
      <pose>13.3 -1.2 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <static>true</static>
      <pose>13.3 1.2 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_2</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <static>true</static>
      <pose>15.7 -1.2 0 0 0 0</pose>
    </include>
    <include>
      <name>cone_3</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Construction Cone</uri>
      <static>true</static>
      <pose>15.7 1.2 0 0 0 0</pose>
    </include>

    <!-- Personel alanında masalar: Fuel (CC0), statik, çarpışma şekli kutu ve
         silindirler. 1,5 × 0,8 m, boy 1 m. 90° döndürülmüş: uzun kenar kuzey-güney.
         x 4,6…5,4 ve 6,6…7,4, y −7,1…−5,6: bölge kenarına en az 1,1 m -->
    <include>
      <name>table_0</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <pose>5 -6.35 0 0 0 1.5708</pose>
    </include>
    <include>
      <name>table_1</name>
      <uri>https://fuel.gazebosim.org/1.0/OpenRobotics/models/Table</uri>
      <pose>7 -6.35 0 0 0 1.5708</pose>
    </include>

    <!-- Yakıt alanında dik tanklar: kendi modelimiz, silindir (r 0,6 m, boy 1,8 m),
         düz renk. Silindirin merkezi ortasındadır: z = boyun yarısı.
         x 18,4…19,6 ve 20,4…21,6, y −6,95…−5,75: bölge kenarına en az 1,2 m -->
    <model name="fuel_tank_0">
      <static>true</static>
      <pose>19 -6.35 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="fuel_tank_1">
      <static>true</static>
      <pose>21 -6.35 0.9 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.6</radius>
              <length>1.8</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.85 0.85 0.8 1</ambient>
            <diffuse>0.85 0.85 0.8 1</diffuse>
            <specular>0.3 0.3 0.3 1</specular>
          </material>
        </visual>
      </link>
