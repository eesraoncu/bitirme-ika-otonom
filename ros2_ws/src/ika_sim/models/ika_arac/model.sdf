    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>BLB_joint</left_joint>
      <left_joint>BLF_joint</left_joint>
      <left_joint>MLB_joint</left_joint>
      <left_joint>MLF_joint</left_joint>
      <left_joint>FLB_joint</left_joint>
      <left_joint>FLF_joint</left_joint>
      <right_joint>BRB_joint</right_joint>
      <right_joint>BRF_joint</right_joint>
      <right_joint>MRB_joint</right_joint>
      <right_joint>MRF_joint</right_joint>
      <right_joint>FRB_joint</right_joint>
      <right_joint>FRF_joint</right_joint>
      <wheel_separation>1.026</wheel_separation>
      <wheel_radius>0.16</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>

  
    <!-- ORINIUM_SENSORS -->
    <!-- ================= LiDAR (YDLidar X2, 2D) ================= -->
    <link name="lidar_link">
      <!-- Kule ustunde (kule tepesi ~0.30): 360 lidar kendi govdesini gormesin.
           YUKSEKLIK SINIRI: bariyerler 0.80 m; buyuk tekerlerle base_link yerden
           ~0.44'te. Lidar duzlemi 0.44+0.34=0.78 < 0.80 olmali ki koridor
           bariyerleri taramada GORUNSUN (0.45'te duzlem 0.89'a cikip barierlerin
           ustunden bakiyordu). -->
      <pose relative_to="base_link">0.0 0.0 0.34 0 0 0</pose>
      <inertial><mass>0.1</mass>
        <inertia><ixx>1e-4</ixx><iyy>1e-4</iyy><izz>1e-4</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.04</radius><length>0.05</length></cylinder></geometry>
        <material><diffuse>0.1 0.1 0.1 1</diffuse><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/scan</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <lidar>
          <scan><horizontal>
            <samples>720</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.12</min><max>8.0</max><resolution>0.01</resolution></range>
        </lidar>
        <gz_frame_id>lidar_link</gz_frame_id>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>

    <!-- ================= IMU (BNO055) ================= -->
    <link name="imu_link">
      <pose relative_to="base_link">0.0 0.0 0.05 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="imu" type="imu">
        <topic>/imu</topic>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
        <gz_frame_id>imu_link</gz_frame_id>
      </sensor>
    </link>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
    </joint>

    <!-- ================= On Derinlik Kamera (RealSense D456) ================= -->
    <link name="camera_link">
      <pose relative_to="base_link">0.58 0.0 0.05 0 0 0</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.03 0.09 0.03</size></box></geometry>
        <material><diffuse>0.2 0.2 0.7 1</diffuse><ambient>0.2 0.2 0.7 1</ambient></material>
      </visual>
      <sensor name="front_camera" type="rgbd_camera">
        <!-- rgbd_camera: /camera base topic'ine gz /camera/image (RGB) +
             /camera/depth_image (32FC1, metre) + /camera/points yayinlar.
             Kopru /camera/image -> /camera/color/image_raw,
             /camera/depth_image -> /camera/depth/image_rect_raw esler.
             DERINLIK KONI ALGILAMA icin gerekli (object_detection depth_m'i
             doldurup koni bulutunu costmap'e basar; 2026-07-20). 10 FPS:
             YOLO 2.5 Hz isledigi icin yeterli, RTF yuku minimumda kalir. -->
        <topic>/camera</topic>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <camera>
          <horizontal_fov>1.204</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>15.0</far></clip>
        </camera>
        <gz_frame_id>camera_link</gz_frame_id>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed">
      <parent>base_link</parent><child>camera_link</child>
    </joint>

    <!-- ================= Geri Kamera ================= -->
    <link name="camera_rear_link">
      <pose relative_to="base_link">-0.99 0.0 0.05 0 0 3.14159</pose>
      <inertial><mass>0.05</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz>
        <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <visual name="camera_rear_visual">
        <geometry><box><size>0.03 0.09 0.03</size></box></geometry>
        <material><diffuse>0.2 0.2 0.7 1</diffuse><ambient>0.2 0.2 0.7 1</ambient></material>
      </visual>
      <!-- ARKA KAMERA SENSORU KAPALI (istek: sim'i yavaslatiyordu). Arka kamera
           otonomide KULLANILMAZ (yalniz GCS "GERI" goruntu); kamera sensoru her
           karede tam sahne render'i yapip RTF'i dusuruyordu. Kaldirildi -> render
           butcesi ON kameraya (koni algilama) + fizige kalir. Geri istenirse
           <sensor name="rear_camera" type="camera"> blogunu buraya geri ekle. -->
    </link>
    <joint name="camera_rear_joint" type="fixed">
      <parent>base_link</parent><child>camera_rear_link</child>
    </joint>

    <!-- ================= TARET (CAD kulesi: KULE_ALT yaw + KULE_UST pitch) ===== -->
    <!-- Nisan kamerasi write_model() icinde dogrudan KULE_UST linkine gomulur:
         hiz komutlu ekleme kaynakli (fixed joint) ayri link baglamak dartsim'de
         fizik patlamasina yol acti; sensorun dinamigi olmadigindan linke gommek
         guvenli. Kule eklem konum kontrolculeri (radyan komut): -->
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>KULE_ALT_joint</joint_name>
      <topic>/turret/yaw</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>5.0</p_gain>
    </plugin>
    <plugin filename="ignition-gazebo-joint-position-controller-system" name="ignition::gazebo::systems::JointPositionController">
      <joint_name>KULE_UST_joint</joint_name>
      <topic>/turret/pitch</topic>
      <use_velocity_commands>true</use_velocity_commands><p_gain>5.0</p_gain>
    </plugin>

  </model>
</sdf>
