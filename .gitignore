# --- GİZLİ: asla depoya girmez (bkz. docs/DECISIONS.md K-007) ---
secrets/
*.key
hmac_key*
.env

# --- ROS 2 / colcon ---
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/

# --- shared/protocol altındaki üretilmiş dosyalar BİLEREK commit edilir ---
# (CubeIDE üreticiyi çalıştırmaz). Güncelliği: python3 tools/gen_protocol.py --check
.pytest_cache/

# --- STM32CubeIDE ---
firmware/Debug/
firmware/Release/
firmware/.settings/
firmware/*.launch

# --- Deney çıktıları (büyük; sonuç özetleri analysis/ içinde tutulur) ---
experiments/runs/
*.bag
*.db3
*.pgm
# İstisna: Nav2'nin kullandığı harita depoda (3.1 ölçütü, K-036)
!ros2_ws/src/ika_nav/maps/*.pgm

# --- Haritalar (büyük ikili dosyalar; hangi haritanın kullanıldığı DECISIONS'ta yazar) ---
*.rtabmap

# --- Editör / sistem ---
.vscode/
.idea/
*.swp
.DS_Store
